PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas M0 URI or local community server)
# If left blank in development, LexiGuard starts a local in-memory Mongo instance for seamless evaluation
MONGODB_URI=mongodb://127.0.0.1:27017/lexiguard

# JWT Secret & Cookie Settings
JWT_SECRET=lexiguard_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=lexiguard_cookie_secret_key_2026

# Google Gemini API Key (Official Google GenAI SDK)
# If omitted or invalid, LexiGuard gracefully falls back to its deterministic LegalTech heuristics engine
GEMINI_API_KEY=

# Maximum stored contracts per account (free tier safeguard)
MAX_CONTRACTS_PER_USER=100
MAX_UPLOAD_SIZE_MB=10
